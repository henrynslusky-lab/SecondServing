{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node --test engine.test.mjs agent.test.mjs hosting.test.mjs",
  "outputDirectory": "public",
  "functions": { "api/agent.js": { "maxDuration": 300 } },
  "rewrites": [{ "source": "/api/agent/:action", "destination": "/api/agent?action=:action" }],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "same-origin" }
  ] }]
}
